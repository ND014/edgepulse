# ==========================================================
# EdgePulse Quantitative Engine - Environment Configuration
# ==========================================================

# (Optional) The-Odds-API Key for live market orderbook fetching
# If left blank, EdgePulse automatically loads high-fidelity historical/cached orderbooks
ODDS_API_KEY=

# Port for the web platform (default: 8080 or platform injected PORT)
PORT=8080

# (Optional) Google OAuth 2.0 Single Sign-On credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
